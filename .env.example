# PostgreSQL (docker-compose exposes it on host port 5433)
DATABASE_URL="postgresql://intake:intake@localhost:5433/intake"

# Transcription provider: "whisper_cpp" (default) or "openai_compatible"
TRANSCRIBER=whisper_cpp

# --- whisper_cpp provider ---
# Path to the whisper-cli binary built from whisper.cpp (Metal + Core ML recommended on Apple Silicon)
WHISPER_CLI_PATH=/opt/homebrew/bin/whisper-cli
# Path to the ggml model file (large-v3-turbo recommended)
WHISPER_MODEL_PATH=/Users/you/whisper.cpp/models/ggml-large-v3-turbo.bin
# ffmpeg is used to convert browser webm/opus recordings to 16 kHz WAV for whisper.cpp
FFMPEG_PATH=ffmpeg

# --- openai_compatible provider ---
# Full URL of an OpenAI-compatible transcription endpoint (e.g. a local faster-whisper server).
# Keep this pointed at localhost — the app is designed to make no third-party calls at runtime.
WHISPER_HTTP_URL=http://127.0.0.1:8000/v1/audio/transcriptions
WHISPER_HTTP_MODEL=whisper-1

# Optional: override where the seed looks for the interview markdown (defaults to ./voice-personality-intake.md)
# INTAKE_MD_PATH=./voice-personality-intake.md

# --- corpus pipeline (npm run corpus -- build) ---
# Optional LLM for profile.json judgment fields. Unset = mechanical-only (same as --no-llm).
# CORPUS_LLM_PROVIDER=anthropic            # or openai_compatible
# CORPUS_LLM_MODEL=claude-sonnet-5
# CORPUS_LLM_API_KEY=
# CORPUS_LLM_URL=                          # openai_compatible base URL, e.g. http://127.0.0.1:11434/v1
# CORPUS_MIN_WORDS=15                      # drop chat messages shorter than this
# CORPUS_CHUNK_MAX_TOKENS=400
# CORPUS_CHUNK_TARGET_TOKENS=300
# CORPUS_DEDUP_THRESHOLD=0.88
